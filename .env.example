# Plano environment variables.
# Copy this file to `.env.local` and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app.
# These values identify your Firebase project; they are NOT secrets.
# Data protection comes from Firebase Security Rules (database.rules.json).
# Never put private keys, passwords or OAuth client secrets here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Realtime Database URL, e.g. https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base path the app is served from. "/" for local dev.
# The GitHub Actions workflow sets it to "/<repo-name>/" automatically.
VITE_BASE_PATH=/
