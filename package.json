{
  "name": "plano",
  "private": true,
  "version": "1.0.0",
  "description": "Plano — Your life. In one place. Personal productivity hub.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src e2e scripts worker rules-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "playwright test --grep-invert @visual",
    "format": "prettier --write src e2e scripts worker rules-test *.ts *.js *.json .github",
    "format:check": "prettier --check src e2e scripts worker rules-test *.ts *.js *.json .github",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only database --project demo-plano \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "glisse": "0.4.3",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
